# Database
POSTGRES_URL=postgres://captiveau:captiveau123@localhost:5432/captiveau
DATABASE_URI=postgres://captiveau:captiveau123@localhost:5432/captiveau

# Payload
PAYLOAD_SECRET=your-secret-key-here
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:4000

# Next.js
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Preview secret — must match the production worker secret (wrangler secret put PREVIEW_SECRET)
PREVIEW_SECRET=your-preview-secret-here

# SMTP (optional) — password reset emails. Empty = log to console.
# Cloudflare Worker cannot open raw SMTP sockets; use a CF-compatible
# adapter (e.g. @payloadcms/email-resend) for real sends there.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM_EMAIL=no-reply@captiveau.id
#SMTP_FROM_NAME=Captiveau CMS

# Revalidation
REVALIDATION_SECRET=your-revalidation-secret

# Node
NODE_ENV=development
