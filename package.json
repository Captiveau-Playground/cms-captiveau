{
  "name": "cms-captiveau",
  "version": "1.0.0",
  "description": "Payload CMS for Captiveau - Creative Tech Studio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 4000",
    "start": "next start",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "seed": "payload run src/seed/index.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm run deploy:database && pnpm run deploy:app",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:cf": "PAYLOAD_CONFIG_PATH=payload.cloudflare.ts opennextjs-cloudflare build",
    "deploy:database": "PAYLOAD_CONFIG_PATH=payload.cloudflare.ts NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate",
    "migrate:create:cf": "PAYLOAD_CONFIG_PATH=payload.cloudflare.ts NODE_ENV=development PAYLOAD_SECRET=ignore payload migrate:create",
    "deploy:app": "pnpm run build:cf && opennextjs-cloudflare deploy",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@gsap/react": "^2.1.2",
    "@lottiefiles/dotlottie-react": "^0.19.10",
    "@payloadcms/db-d1-sqlite": "^3.88.0",
    "@payloadcms/db-postgres": "latest",
    "@payloadcms/email-nodemailer": "^3.88.0",
    "@payloadcms/next": "latest",
    "@payloadcms/payload-cloud": "latest",
    "@payloadcms/richtext-lexical": "latest",
    "@payloadcms/storage-r2": "^3.88.0",
    "@payloadcms/storage-s3": "latest",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "payload": "latest",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.13.1",
    "sharp": "0.35.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "0.31.7",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0"
  }
}